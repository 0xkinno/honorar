#!/bin/sh
ROOT="$(git rev-parse --show-toplevel)"
GL="$ROOT/.tools/gitleaks.exe"
[ -x "$GL" ] || GL="$(command -v gitleaks)"
[ -n "$GL" ] || { echo "gitleaks not found"; exit 1; }
"$GL" git --staged --redact -c "$ROOT/.gitleaks.toml" --no-banner || exit 1
node "$ROOT/scripts/check-clean.mjs" || exit 1
