pragma solidity ^0.8.24;

import {Base} from "./Base.t.sol";
import {HonorarLedger} from "../src/HonorarLedger.sol";

/// Golden vectors generated by the TypeScript kernel (scripts/gen-vectors.ts).
contract VectorsTest is Base {
    function test_kernel_vectors_match_onchain_root_rule() public view {
        uint256 checked;
        for (uint256 f; f < 20; ++f) {
            checked += _checkFile(string.concat("test/vectors/", vm.toString(f), ".json"));
        }
        assertEq(checked, 2000);
    }

    function _checkFile(string memory path) internal view returns (uint256 checked) {
        string memory json = vm.readFile(path);
        for (uint256 c; c < 100; ++c) {
            string memory p = string.concat(".cases[", vm.toString(c), "]");
            bytes32[] memory ids = vm.parseJsonBytes32Array(json, string.concat(p, ".workIds"));
            uint256[] memory versions = vm.parseJsonUintArray(json, string.concat(p, ".versions"));
            bytes32[] memory spans = vm.parseJsonBytes32Array(json, string.concat(p, ".spanHashes"));
            uint256[] memory amounts = vm.parseJsonUintArray(json, string.concat(p, ".amounts"));
            bytes32 expected = vm.parseJsonBytes32(json, string.concat(p, ".root"));
            HonorarLedger.Leaf[] memory leaves = new HonorarLedger.Leaf[](ids.length);
            for (uint256 i; i < ids.length; ++i) {
                leaves[i] = HonorarLedger.Leaf(ids[i], uint32(versions[i]), spans[i], uint64(amounts[i]));
            }
            assertEq(_root(leaves), expected);
            ++checked;
        }
    }
}
